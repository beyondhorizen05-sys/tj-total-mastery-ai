# TJ — Total Mastery AI  (.env.example)
# Copy to .env (never commit .env).  All values optional unless marked.

# ---- Server ----
TJ_HOST=127.0.0.1
TJ_PORT=4780
# Where TJ stores its SQLite database, vault, artifacts, projects.
# Default: <repo>/.tj-data  (first-run wizard can change this)
TJ_DATA_DIR=

# ---- Security ----
# Optional: override the vault master key (base64, 32 bytes). If unset TJ generates one and
# protects it with Windows DPAPI (or file permissions on other OSes).
TJ_VAULT_MASTER_KEY=
# Comma-separated allowed browser origins for the API (CORS). Default: Vite dev + Tauri origins.
TJ_ALLOWED_ORIGINS=

# ---- Provider API keys (optional bootstrap; they are imported into the encrypted vault on first start
#      and then you may delete them from this file). Prefer adding providers through the UI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
# Local model servers (no key needed)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# ---- Connectors (optional bootstrap) ----
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
OPENWEATHER_API_KEY=
GITHUB_TOKEN=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
ELEVENLABS_API_KEY=

# ---- Testing ----
# Enables the deterministic "Test Provider" (clearly labelled, not an AI). Used by automated tests.
TJ_ENABLE_TEST_PROVIDER=0
