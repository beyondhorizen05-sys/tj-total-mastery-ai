{
  "name": "@tj/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --import tsx --watch src/main.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "migrate": "node --disable-warning=ExperimentalWarning --import tsx src/cli/migrate.ts",
    "ingest-skills": "node --disable-warning=ExperimentalWarning --import tsx src/cli/ingest-skills.ts",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude \"**/e2e/**\"",
    "test:e2e": "vitest run tests/e2e",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^9.0.0",
    "@tj/schemas": "workspace:*",
    "croner": "^10.0.1",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/yauzl": "^3.4.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
